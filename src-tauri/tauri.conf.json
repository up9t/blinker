{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "blinker",
  "version": "../package.json",
  "identifier": "org.blinker.blinker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Blinker",
        "width": 1200,
        "height": 700,
        "resizable": true,
        "url": "/"
      },
      {
        "label": "overlay",
        "title": "Overlay",
        "fullscreen": true,
        "resizable": true,
        "visible": false,
        "url": "/overlay",
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
